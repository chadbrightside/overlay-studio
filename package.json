{
  "name": "overlay-studio",
  "version": "0.10.3",
  "description": "Local AI overlay editor for commentary videos: transcribe, plan overlays with Claude, render at native resolution, export for YouTube or your NLE.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/start.js",
    "setup": "node src/setup.js",
    "cli": "node src/cli.js",
    "update-check": "node -e \"import('./src/update.js').then(m=>m.checkForUpdate()).then(r=>console.log(r))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@ffprobe-installer/ffprobe": "latest",
    "@fontsource/cairo": "latest",
    "@fontsource/inter": "latest",
    "d3-array": "^3.2.5",
    "d3-geo": "latest",
    "express": "latest",
    "ffmpeg-static": "latest",
    "flag-icons": "^7.3.2",
    "playwright": "latest",
    "topojson-client": "latest",
    "world-atlas": "latest",
    "zod": "latest"
  },
  "overlayStudio": {
    "repo": "chadbrightside/overlay-studio",
    "branch": "main"
  }
}
